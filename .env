VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Replace with your Google OAuth 2.0 Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# KHQR / Bakong scan-to-pay merchant identity (used to build the checkout QR code).
# VITE_KHQR_ACCOUNT MUST be a real, registered Bakong account ID in the form
# "name@bank_domain" (e.g. yourstore@aba, 012345678@wing). Banking apps look the
# account up on scan, so a QR built for an account that does not exist is
# rejected as an "Invalid QR Code". Leave blank to use the built-in fallback.
VITE_KHQR_ACCOUNT=
# Shown inside the customer's banking app after a successful scan.
VITE_KHQR_MERCHANT_NAME=MEN ITC STORE
VITE_KHQR_MERCHANT_CITY=Phnom Penh
